# Copie para .env.local (fora do Git) e preencha. Ver docs/SETUP-VERCEL-SUPABASE-GIT.md seção 3.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# chave anon/publishable: pode ir ao navegador (a RLS protege), mas este app só a usa no servidor
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon ou publishable key>
